	<string>This app lets the user take a photo to upload to the Retrolux web application</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>This app does not require user location</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>This app does not require user location(s)</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Lets user take photos and upload to Retrolux web application</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>This app lets the user save a photo to the camera roll as a backup</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>This app lets the user upload a photo to the Retrolux web application</string>
